# /var/lib/game-hub/.env  — read by the game-hub server at start.
# Keep this file outside the deployed directory; deploys never touch it.

# OAuth client ID from Google Cloud Console (type "Web application").
GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com

# The exact address players open, without a trailing slash.
PUBLIC_ORIGIN=https://games.example.com

# Loopback port nginx proxies /api/ to. Pick one nothing else on the box uses.
PORT=3100

# SQLite database file.
DB_FILE=/var/lib/game-hub/game-hub.db
